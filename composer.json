{
    "name": "1tomany/data-uri",
    "description": "Safely materialize data URIs, local files, URLs, Base64, and text as managed temporary files",
    "license": "MIT",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "datauri",
        "data uri",
        "data-uri",
        "temporary file",
        "upload",
        "base64",
        "2397",
        "rfc2397",
        "rfc 2397"
    ],
    "require": {
        "php": ">=8.4",
        "ext-fileinfo": "*",
        "symfony/filesystem": "^7.2|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpstan": "^2.1.55",
        "phpunit/phpunit": "^13.1.11",
        "symfony/console": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "OneToMany\\DataUri\\": "src/"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OneToMany\\DataUri\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs",
            "@stan",
            "@test"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --sequential",
        "fix": "php-cs-fixer fix --sequential",
        "stan": "phpstan analyse --no-progress --debug",
        "test": "phpunit",
        "flat": [
            "@fix",
            "@stan",
            "@test"
        ]
    },
    "authors": [
        {
            "name": "Vic Cherubini",
            "email": "vcherubini@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true
    }
}
